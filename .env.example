# Groq (server-side — Vite dev middleware, Analog, Supabase Edge Function)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_DEEP=llama-3.3-70b-versatile
# CORS das Edge Functions — em producao use o dominio final (ex: https://seu-dominio.com)
ALLOWED_ORIGIN=*

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production chat API (Supabase Edge Function URL)
# Example: https://your-project.supabase.co/functions/v1/chat
VITE_CHAT_API_URL=/api/chat
VITE_CARD_INSIGHT_API_URL=/api/interpret-card

# Site URL (SEO, OAuth redirects, RSS)
VITE_SITE_URL=http://127.0.0.1:5173

# Google OAuth — set to false to hide the button until Supabase Google provider is enabled
# Supabase: Authentication > Providers > Google (enable + Client ID/Secret)
# Google Cloud: OAuth redirect URI = https://YOUR-PROJECT.supabase.co/auth/v1/callback
# Supabase Auth URL config: add http://127.0.0.1:5173/auth/callback to Redirect URLs
VITE_GOOGLE_AUTH_ENABLED=true

# Analytics (opt-in — requires LGPD consent banner)
VITE_ANALYTICS_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=

# Upstash Redis (Edge Function rate limiting — optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (auth emails + newsletter digest via Edge Function)
RESEND_API_KEY=
RESEND_FROM_EMAIL=oracle@your-domain.com

# OneSignal (web push — optional)
VITE_ONESIGNAL_APP_ID=

# Cookie consent (Cookiebot — optional SaaS CMP)
VITE_COOKIEBOT_ID=
